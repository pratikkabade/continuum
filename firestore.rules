rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidClip(data) {
      return data.keys().hasAll(['id', 'content', 'type', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.content is string && data.content.size() <= 1048576 &&
        data.type in ['text', 'code', 'url', 'color', 'image'] &&
        data.createdAt is number;
    }

    // Public / shared clipboard documents
    match /clips/{clipId} {
      allow read: if isValidId(clipId);
      allow create: if isValidId(clipId) && isValidClip(request.resource.data);
      allow update: if isValidId(clipId) && isValidClip(request.resource.data);
      allow delete: if isValidId(clipId);
    }
  }
}
