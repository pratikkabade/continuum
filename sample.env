# Firebase Configuration for Continuum Glass OS Clipboard
# Replace with your Firebase project credentials from Firebase Console -> Project Settings -> General -> Your apps
VITE_FIREBASE_API_KEY="AIzaSyExampleKeyForContinuumClipboard"
VITE_FIREBASE_AUTH_DOMAIN="continuum-clipboard.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="continuum-clipboard"
VITE_FIREBASE_STORAGE_BUCKET="continuum-clipboard.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_DATABASE_ID="(default)"
